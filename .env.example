# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=production

# Server URL where your backend is accessible (Domain or VPS IP)
# Used to construct accessible URLs for uploaded images & PDFs:
# Example: https://api.yourdomain.com OR http://123.45.67.89:3000
SERVER_URL=https://api.yourdomain.com

# Storage driver: 'local' (recommended for Hostinger VPS) or 'cloud'
STORAGE_DRIVER=local

# ==========================================
# DATABASE & SECURITY
# ==========================================
DATA_BASE_URL=mongodb+srv://username:password@cluster.mongodb.net/soloshine?retryWrites=true&w=majority
JWT_SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_characters

# ==========================================
# OPTIONAL: FIREBASE NOTIFICATIONS (If used)
# ==========================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==========================================
# OPTIONAL: LEGACY / BACKUP CLOUD STORAGE (Optional)
# ==========================================
# IMGBB_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=
